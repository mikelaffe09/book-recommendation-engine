# Supabase
# Use your own project URL. Do not include a real production URL in the public repo if you want to keep it private.
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-side Supabase key.
# For private/server-only scripts, you may use a service role key.
# Never expose this key in frontend, mobile, or browser code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase table names
SUPABASE_BOOK_CATALOGUE_TABLE=book_catalogue
SUPABASE_USER_BOOKS_TABLE=books
SUPABASE_RECOMMENDATIONS_TABLE=book_recommendations

# Internal API protection
# Generate a long random value for your real .env file.
RECOMMENDER_INTERNAL_SECRET=replace-with-a-long-random-secret

# Optional API settings
API_TITLE=Personalized Book Recommendation API
API_VERSION=1.0.0
API_SERVICE_NAME=book-recommendation-engine